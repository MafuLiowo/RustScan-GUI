QWidget {
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 14px;
}

QMainWindow,
QWidget#RootPanel,
QWidget#ContentPanel {
    background-color: #f3f5f7;
    color: #20242a;
}

QMenuBar {
    background-color: #ffffff;
    color: #20242a;
    border-bottom: 1px solid #d6dae0;
    padding: 2px 6px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #e7edf5;
}

QMenuBar::item:pressed {
    background-color: #dbe5f0;
}

QMenu {
    background-color: #ffffff;
    color: #20242a;
    border: 1px solid #d6dae0;
    padding: 4px;
}

QMenu::item {
    padding: 6px 28px 6px 18px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #e4ecf6;
    color: #111418;
}

QMenu::item:disabled {
    color: #a0a6ad;
}

QMenu::separator {
    height: 1px;
    background-color: #d6dae0;
    margin: 4px 8px;
}

QFrame#Sidebar {
    background-color: #ffffff;
    border-right: 1px solid #d6dae0;
}

QFrame#SettingsSidebar {
    background-color: #ffffff;
    border-right: 1px solid #d6dae0;
}

QFrame#ScriptsSidebar {
    background-color: #ffffff;
    border-right: 1px solid #d6dae0;
}

QLabel#SettingsNavTitle {
    color: #111418;
    font-size: 18px;
    font-weight: 600;
    padding: 0 8px;
}

QPushButton#SettingsNavButton {
    background-color: #eef1f4;
    border: 1px solid #d6dae0;
    border-radius: 6px;
    color: #20242a;
    font-weight: 600;
    padding: 9px 12px;
    text-align: left;
}

QPushButton#SettingsNavButton:hover {
    background-color: #e4e9ef;
}

QPushButton#SettingsNavButton:checked {
    background-color: #dbe9f7;
    border-color: #9dc1e6;
    color: #111418;
}

QLabel#BrandTitle {
    font-size: 24px;
    font-weight: 600;
    color: #111418;
}

QLabel#BrandSubtitle {
    font-size: 14px;
    font-weight: 500;
    color: #30363d;
}

QLabel#SectionLabel {
    color: #5f6670;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 4px 6px 0 6px;
}

QToolButton#SidebarCloseButton {
    border: none;
    border-radius: 4px;
    color: #5f6670;
    font-size: 18px;
    font-weight: 600;
}

QToolButton#SidebarCloseButton:hover {
    background-color: #e7eaee;
    color: #111418;
}

QToolButton#SidebarCloseButton:pressed {
    background-color: #dbe1e8;
}

QTreeWidget#ProjectTree {
    background-color: transparent;
    border: none;
    color: #2b3036;
    outline: 0;
    padding: 2px;
    show-decoration-selected: 0;
}

QTreeWidget#ProjectTree::item {
    padding: 6px 6px;
    border-radius: 4px;
}

QTreeWidget#ProjectTree::item:hover {
    background-color: #f0f3f6;
}

QTreeWidget#ProjectTree::item:selected {
    background-color: #dbe9f7;
    color: #111418;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QTreeView::branch:selected {
    background-color: #dbe9f7;
    border: none;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

QTreeView::branch {
    background: transparent;
}

QTreeView::branch:has-children:closed {
    image: url("{ASSETS_DIR}/icons/chevron-right.png");
}

QTreeView::branch:has-children:open {
    image: url("{ASSETS_DIR}/icons/chevron-down.png");
}

QLabel#PageTitle {
    font-size: 22px;
    font-weight: 600;
    color: #111418;
}

QLabel#CardTitle {
    font-size: 16px;
    font-weight: 600;
    color: #111418;
}

QLabel#Muted {
    color: #5f6670;
}

QLabel#KeyLabel {
    color: #5f6670;
}

QLabel#ValueLabel {
    color: #20242a;
}

QFrame#Card {
    background-color: #ffffff;
    border: 1px solid #dfe3e8;
    border-radius: 10px;
}

QPlainTextEdit#LogView {
    background-color: #ffffff;
    color: #20242a;
    border: 1px solid #d6dae0;
    border-radius: 8px;
    padding: 10px;
    selection-background-color: #2f6faf;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
}

QPlainTextEdit#ScriptContent,
QPlainTextEdit#ScriptEditor {
    background-color: #ffffff;
    color: #20242a;
    border: 1px solid #d6dae0;
    border-radius: 8px;
    padding: 10px;
    selection-background-color: #2f6faf;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
}

QListWidget#ScriptList {
    background-color: #ffffff;
    border: 1px solid #d6dae0;
    border-radius: 8px;
    padding: 4px;
    color: #20242a;
    outline: 0;
}

QListWidget#ScriptList::item {
    padding: 8px 10px;
    border-radius: 6px;
    margin: 2px;
}

QListWidget#ScriptList::item:hover {
    background-color: #eef1f4;
}

QListWidget#ScriptList::item:selected {
    background-color: #dbe8f5;
    color: #17324d;
}

QStatusBar {
    background-color: #ffffff;
    color: #5f6670;
    border-top: 1px solid #d6dae0;
}

QStatusBar::item {
    border: none;
}

QLineEdit {
    background-color: #ffffff;
    border: 1px solid #c7ccd3;
    border-radius: 6px;
    padding: 6px 8px;
    color: #20242a;
    selection-background-color: #2f6faf;
}

QLineEdit:focus {
    border-color: #2f6faf;
}

QPushButton {
    background-color: #eef1f4;
    border: 1px solid #cbd1d8;
    border-radius: 6px;
    padding: 6px 16px;
    color: #20242a;
}

QPushButton:hover {
    background-color: #e3e8ee;
}

QPushButton:pressed {
    background-color: #d9dfe6;
}

QPushButton#StartScanButton {
    background-color: #7fb2e5;
    color: #10202f;
    border: 1px solid #6ea4d8;
    border-radius: 6px;
    padding: 9px 24px;
    font-weight: 600;
}

QPushButton#StartScanButton:hover {
    background-color: #93c2ee;
    border-color: #83b4e4;
}

QPushButton#StartScanButton:pressed {
    background-color: #6c9fd2;
    border-color: #5f93c7;
}

QPushButton#StartScanButton:disabled {
    background-color: #d7dde5;
    border-color: #cbd2da;
    color: #9aa0a6;
}

QLabel#DangerDialogTitle {
    color: #111418;
    font-size: 18px;
    font-weight: 600;
}

QPushButton#DangerButton {
    background-color: #d9534f;
    color: #ffffff;
    border: 1px solid #c9433f;
    border-radius: 6px;
    padding: 7px 20px;
    font-weight: 600;
}

QPushButton#DangerButton:hover {
    background-color: #c9433f;
    border-color: #b93b37;
}

QPushButton#DangerButton:pressed {
    background-color: #b93b37;
    border-color: #a8322e;
}

QPushButton#SuccessButton {
    background-color: #2f9e5b;
    color: #ffffff;
    border: 1px solid #26894e;
    border-radius: 6px;
    padding: 7px 20px;
    font-weight: 600;
}

QPushButton#SuccessButton:hover {
    background-color: #26894e;
    border-color: #1f7543;
}

QPushButton#SuccessButton:pressed {
    background-color: #1f7543;
    border-color: #196039;
}

QPushButton#SuccessButton:disabled {
    background-color: #d7dde5;
    border-color: #cbd2da;
    color: #9aa0a6;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #c3c9d1;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QToolTip {
    background-color: #ffffff;
    color: #20242a;
    border: 1px solid #c7ccd3;
    padding: 4px 6px;
}

QLabel#RequiredMark {
    color: #d64545;
    font-weight: 600;
}

QLabel#FieldLabel {
    color: #4a515a;
    font-weight: 500;
}

QStackedWidget#ContentStack,
QStackedWidget#SettingsSectionStack,
QWidget#WelcomePage,
QWidget#ScanPage,
QWidget#ScanOptionsPage,
QScrollArea#ScanOptionsScroll,
QWidget#ScanOptionsContent,
QWidget#ScanResultsPage,
QWidget#ScanLogsPage,
QWidget#SettingsPage,
QWidget#SettingsContent,
QWidget#SettingsSectionPage,
QWidget#ScriptsPage,
QWidget#ScriptsContent {
    background-color: transparent;
}

QTabWidget#ScanTabs::tab-bar {
    left: 0px;
}

QTabWidget#ScanTabs::pane {
    background-color: #ffffff;
    border: 1px solid #d6dae0;
    border-radius: 8px;
    border-top-left-radius: 0px;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #5f6670;
    padding: 8px 18px;
    border: 1px solid transparent;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #111418;
    border-color: #d6dae0;
    border-bottom-color: #ffffff;
}

QTabBar::tab:hover:!selected {
    color: #20242a;
}

QComboBox {
    background-color: #ffffff;
    border: 1px solid #c7ccd3;
    border-radius: 6px;
    padding: 5px 10px;
    color: #20242a;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #9aa3ad;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #20242a;
    border: 1px solid #d6dae0;
    selection-background-color: #dbe9f7;
    selection-color: #111418;
    outline: 0;
}

QTableWidget#ResultTable {
    background-color: #ffffff;
    alternate-background-color: #f7f8fa;
    color: #20242a;
    border: none;
    gridline-color: #e2e6eb;
    selection-background-color: #dbe9f7;
    selection-color: #111418;
}

QTableWidget#ResultTable::item {
    padding: 5px 6px;
}

QHeaderView::section {
    background-color: #f0f2f5;
    color: #5f6670;
    border: none;
    border-bottom: 1px solid #d6dae0;
    border-right: 1px solid #d6dae0;
    padding: 6px;
    font-weight: 600;
}

QTableCornerButton::section {
    background-color: #f0f2f5;
    border: none;
}

QComboBox::down-arrow {
    image: url("{ASSETS_DIR}/icons/chevron-down.png");
    width: 12px;
    height: 12px;
}

QLineEdit:disabled {
    background-color: #f0f2f5;
    color: #9aa0a6;
    border-color: #d6dae0;
}
